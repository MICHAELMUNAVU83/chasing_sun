<div class="mx-auto max-w-sm px-4 py-16">
  <h1 class="text-2xl font-semibold text-[var(--ink)]">Create account</h1>
  <p class="mt-1 text-sm text-[var(--muted)]">
    Already have one?
    <.link navigate={~p"/users/log_in"} class="text-[var(--brand-green-deep)] hover:underline">
      Log in
    </.link>
  </p>

  <.form :let={f} for={@changeset} action={~p"/users/register"} class="mt-8 space-y-5">
    <.error :if={@changeset.action == :insert}>
      Please fix the errors below.
    </.error>

    <.input field={f[:email]} type="email" label="Email" required />
    <.input field={f[:password]} type="password" label="Password" required />

    <.button
      phx-disable-with="Creating account..."
      class="w-full rounded-md bg-[var(--brand-green)] px-5 py-2.5 text-sm font-medium hover:bg-[var(--brand-green-deep)]"
    >
      Create account
    </.button>
  </.form>
</div>
