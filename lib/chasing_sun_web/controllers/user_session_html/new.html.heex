<div class="mx-auto max-w-sm px-4 py-16">
  <h1 class="text-2xl font-semibold text-[var(--ink)]">Log in</h1>
  <p class="mt-1 text-sm text-[var(--muted)]">
    No account yet?
    <.link navigate={~p"/users/register"} class="text-[var(--brand-green-deep)] hover:underline">
      Sign up
    </.link>
  </p>

  <.form
    :let={f}
    for={@conn.params["user"]}
    as={:user}
    action={~p"/users/log_in"}
    class="mt-8 space-y-5"
  >
    <.error :if={@error_message}>{@error_message}</.error>

    <.input field={f[:email]} type="email" label="Email" required />
    <.input field={f[:password]} type="password" label="Password" required />

    <div class="flex items-center justify-between">
      <.input field={f[:remember_me]} type="checkbox" label="Remember me" />
      <.link
        href={~p"/users/reset_password"}
        class="text-sm text-[var(--brand-green-deep)] hover:underline"
      >
        Forgot password?
      </.link>
    </div>

    <.button
      phx-disable-with="Logging in..."
      class="w-full rounded-md bg-[var(--brand-green)] px-5 py-2.5 text-sm font-medium hover:bg-[var(--brand-green-deep)]"
    >
      Log in
    </.button>
  </.form>
</div>
