<.flash_group flash={@flash} />
<div class="min-h-screen bg-white">
  <header class="border-b border-[var(--line)]">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
      <.link navigate={~p"/"} class="flex items-center gap-2">
        <img src={~p"/images/CHASING-SUN.png"} alt="ChasingSun logo" class="h-8 w-8 rounded-md" />
        <span class="text-lg font-semibold text-[var(--ink)]">ChasingSun</span>
      </.link>
      <nav class="flex items-center gap-4 text-sm">
        <%= if @current_user do %>
          <span class="hidden text-[var(--muted)] sm:inline">{@current_user.email}</span>
          <.link
            href={~p"/users/log_out"}
            method="delete"
            class="text-[var(--muted)] hover:text-[var(--ink)]"
          >
            Log out
          </.link>
        <% else %>
          <.link navigate={~p"/users/log_in"} class="text-[var(--ink)] hover:underline">
            Log in
          </.link>
        <% end %>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <h1 class="max-w-2xl text-4xl font-semibold text-[var(--ink)]">
      Greenhouse records for the ChasingSun team
    </h1>
    <p class="mt-4 max-w-xl text-base leading-7 text-[var(--muted)]">
      Track crop cycles, log weekly harvests, and see expected output for the coming weeks.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <%= if @current_user do %>
        <.link
          navigate={~p"/dashboard"}
          class="rounded-md bg-[var(--brand-green)] px-5 py-2.5 text-sm font-medium text-white hover:bg-[var(--brand-green-deep)]"
        >
          Go to dashboard
        </.link>
        <.link
          navigate={~p"/users/settings"}
          class="rounded-md border border-[var(--line-strong)] px-5 py-2.5 text-sm font-medium text-[var(--ink)] hover:bg-[var(--surface-soft)]"
        >
          Settings
        </.link>
      <% else %>
        <.link
          navigate={~p"/users/log_in"}
          class="rounded-md bg-[var(--brand-green)] px-5 py-2.5 text-sm font-medium text-white hover:bg-[var(--brand-green-deep)]"
        >
          Log in
        </.link>
        <.link
          navigate={~p"/users/register"}
          class="rounded-md border border-[var(--line-strong)] px-5 py-2.5 text-sm font-medium text-[var(--ink)] hover:bg-[var(--surface-soft)]"
        >
          Create account
        </.link>
      <% end %>
    </div>

    <div class="mt-16 grid gap-8 border-t border-[var(--line)] pt-10 sm:grid-cols-3">
      <div>
        <h2 class="font-medium text-[var(--ink)]">Greenhouses</h2>
        <p class="mt-1 text-sm leading-6 text-[var(--muted)]">
          Each greenhouse, its venture, and the crop currently in it.
        </p>
      </div>
      <div>
        <h2 class="font-medium text-[var(--ink)]">Harvests</h2>
        <p class="mt-1 text-sm leading-6 text-[var(--muted)]">
          Enter weekly actuals and compare them with what was expected.
        </p>
      </div>
      <div>
        <h2 class="font-medium text-[var(--ink)]">Forecast</h2>
        <p class="mt-1 text-sm leading-6 text-[var(--muted)]">
          Expected output for the next 8 weeks and what to plant next.
        </p>
      </div>
    </div>
  </main>
</div>
